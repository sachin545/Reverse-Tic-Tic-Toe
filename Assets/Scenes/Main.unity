  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>GRID & PLAYERS:</b>\n\u2022 5\xD75 Grid (25 empty cells)\n\u2022 2
    Players locally on the same device\n\u2022 Player 1 uses <b>X</b>, Player 2 uses
    <b>O</b>\n\n<b>THE REVERSE RULE:</b>\n\u2022 The player who creates <b>three
    or more consecutive identical symbols</b> in a line horizontally, vertically,
    or diagonally...\n   <color=#FF3366><b>IMMEDIATELY LOSES THE GAME!</b></color>\n\u2022
    The other player wins!\n\n<b>STRATEGY & DRAW:</b>\n\u2022 Strategically place
    symbols without completing a 3-in-a-row.\n\u2022 Trap your opponent so their
    only legal moves form a losing line!\n\u2022 If all 25 cells are filled without
    any losing line, it's a <b>DRAW</b>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
